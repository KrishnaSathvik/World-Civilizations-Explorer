# Copy this file to `.env.local` (git-ignored) and fill in real values, or set
# these as environment variables in your hosting provider (e.g. Vercel).
#
# Only the PUBLIC Supabase values belong here. These are safe to expose to the
# browser (the anon key is gated by Row-Level Security). NEVER put the Supabase
# service-role key, database URL, or any private secret in a NEXT_PUBLIC_* var.

# Supabase (public/client-safe)
NEXT_PUBLIC_SUPABASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"

# Canonical site origin (used for canonical URLs, sitemap, and OG metadata)
NEXT_PUBLIC_SITE_URL="https://your-domain.example"
